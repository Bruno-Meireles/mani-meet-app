# Copie para .env (local) ou cadastre na Vercel. Nunca commite chaves reais.
# Passo a passo completo: docs/INSTALACAO.md

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Obrigatória: o servidor lê/grava agendamentos com ela. SECRETA, nunca use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Lembretes por e-mail (GET/POST /api/public/send-reminders, 1x/dia via Vercel Cron) ---
# CRON_SECRET="segredo-longo-e-aleatorio"
# RESEND_API_KEY="re_..."
# REMINDER_FROM_EMAIL="Nome do Salão <lembretes@seudominio.com>"

# --- Opcional: sobrescreve o WhatsApp definido em src/config/site.ts ---
# VITE_WHATSAPP_NUMBER="11999999999"
