# Dedicated Supabase (https://<project-ref>.supabase.co)
# Copy to .env and fill from Project Settings > API.
# Never commit real keys.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Optional. Only needed if you start using src/integrations/supabase/client.server.ts
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
